{
  "name": "@mrzr/react-svg-icons",
  "version": "0.1.0",
  "description": "Turn a folder of SVG icons into typed React components, with a prop per colour and a lazy-loaded Icon.",
  "keywords": [
    "icons",
    "svg",
    "react",
    "svgo",
    "codegen",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammadreza-zr/react-svg-icons.git"
  },
  "homepage": "https://github.com/mohammadreza-zr/react-svg-icons#readme",
  "bugs": {
    "url": "https://github.com/mohammadreza-zr/react-svg-icons/issues"
  },
  "type": "module",
  "bin": {
    "react-svg-icons": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node scripts/test.mjs",
    "docs:sync": "bash scripts/sync-wiki.sh",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "svgo": "^4.0.2",
    "svgson": "^5.3.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "~6.0.2"
  }
}
